"""check_webdiff - LibreNMS/Nagios check that a web page has not been tampered with.

Version: 1.0
Author: Jason Cheng (Jason Tools) <jason@jason.tools>
https://github.com/jasoncheng7115/jt-lnms-plugins

Fetches a page, strips content that changes on every request (cache-busting
parameters, nonces, CSRF tokens, timestamps, HTML comments), and compares the
rest with a stored baseline. When something differs the page is fetched once
more: parts that differ between the two fetches are random and are ignored,
only changes present in both count. External script/iframe/form hosts are
tracked separately, and expected / rejected text can be checked on every run.
A change keeps being reported until it is accepted with --accept (or use --once).

Replaces check_diff_webhtml (different options, not compatible).

Exit: 0 OK / 1 WARNING / 2 CRITICAL / 3 UNKNOWN
"""

import argparse
import difflib
import fcntl
import hashlib
import html
import html.parser
import json
import os
import re
import ssl
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

VERSION = '1.0'
OK, WARNING, CRITICAL, UNKNOWN = 0, 1, 2, 3
STATE = {OK: 'OK', WARNING: 'WARNING', CRITICAL: 'CRITICAL', UNKNOWN: 'UNKNOWN'}
MAX_BODY = 5 * 1024 * 1024
STATE_DIR = '/var/tmp/check_webdiff'
USER_AGENT = 'check_webdiff/%s (+https://github.com/jasoncheng7115/jt-lnms-plugins)' % VERSION

