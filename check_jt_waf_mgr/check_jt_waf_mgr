           'm.the last two runs failed': '最近兩次都失敗', 'm.nothing applied yet': '尚未套用過', 'm.pid file not readable': '讀不到 pid 檔'},
 'en': {'ok': 'working', 'down': 'cannot reach jt-waf-mgr', 'http': 'API HTTP error', 'auth': 'API token invalid or source not allowed',
        'invalid': 'invalid API data', 'key': 'cannot read the API token file', 'ignored': '(ignored)',
        'events1h': 'events in the last hour', 'blocked1h': 'blocked', 'blocked24h': 'blocked in 24 hours', 'lastevent': 'last event',
        'ago': 's ago', 'ipblocks': 'blocked IPs', 'alerts': 'open alerts', 'pending': 'changes awaiting approval', 'none': 'none',
        'nginx': 'nginx', 'modsecurity': 'ModSecurity', 'managed_rules': 'managed rule files', 'last_apply': 'last apply',
        'collector': 'event collector', 'ip_blocks': 'IP block list', 'program_integrity': 'program integrity', 'audit_chain': 'audit chain',
        'config_changes': 'outside configuration changes', 'analyst': 'event analysis'},
}
PERF = ('problems', 'events1h', 'blocked1h', 'blocked24h', 'lasteventagesec', 'collectorlagsec', 'ipblocks', 'openalerts',
        'pendingchanges')
STATE = {'ok': 0, 'warning': 1, 'critical': 2}


def number(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)


class _HTTPS(http.client.HTTPSConnection):
    """Connects to the given address but sends --vhost as the TLS server name (SNI)."""
    def __init__(self, host, port, sni, **kw):
        super().__init__(host, port, **kw)
        self._sni = sni

    def connect(self):
        sock = socket.create_connection((self.host, self.port), self.timeout)
        self.sock = self._context.wrap_socket(sock, server_hostname=self._sni)


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('-H', '--host', required=True, help='jt-waf-mgr host or address (LibreNMS adds it)')
    p.add_argument('-p', '--port', type=int, default=443)
    p.add_argument('--vhost', help='the management site name (Host header and TLS SNI), e.g. waf.example.com')
    p.add_argument('--no-ssl', action='store_true', help='plain http (e.g. straight to 127.0.0.1:8095)')
    p.add_argument('-k', '--insecure', action='store_true', help='do not verify the TLS certificate')
    p.add_argument('--ca-file', help='CA bundle for a private CA')
    p.add_argument('--token-file', required=True, help='file with the API token (scope status:read)')
    p.add_argument('--ignore', default='', help='comma-separated check names left out of the overall state')
    p.add_argument('-t', '--timeout', type=float, default=10)
    p.add_argument('-l', '--language', choices=['zh-tw', 'en'], default='zh-tw')
    a = p.parse_args()
    t = TEXT[a.language]
    colon = '：' if a.language == 'zh-tw' else ': '
    perf = dict.fromkeys(PERF)
    lines = []

    def emit(code, summary):
        print('JT-WAF-MGR ' + {0: 'OK', 1: 'WARNING', 2: 'CRITICAL', 3: 'UNKNOWN'}[code] + ' - ' + summary.replace('|', '/'))
        for line in lines:
            print(str(line).replace('|', '/').replace('\r', ' '))
        print('| ' + ' '.join(k + '=' + ('%d' % perf[k] if number(perf[k]) else 'U') + ';;;0' for k in PERF))
        return code

    def msg(m):
        return TEXT['zh-tw'].get('m.' + m, m) if a.language == 'zh-tw' else m

    try:
        token = Path(a.token_file).read_text().strip()
        if not token or '\n' in token:
            raise ValueError()
    except (OSError, ValueError):
        return emit(3, t['key'])
    name = a.vhost or a.host
    headers = {'Authorization': 'Bearer ' + token, 'Accept': 'application/json', 'Host': name,
               'User-Agent': 'check_jt_waf_mgr/1.0'}
    try:
        if a.no_ssl:
            c = http.client.HTTPConnection(a.host, a.port, timeout=a.timeout)
        else:
            ctx = ssl.create_default_context(cafile=a.ca_file) if a.ca_file else ssl.create_default_context()
            if a.insecure:
                ctx.check_hostname = False
                ctx.verify_mode = ssl.CERT_NONE
            c = _HTTPS(a.host, a.port, name, timeout=a.timeout, context=ctx)
        c.request('GET', '/api/v1/health', headers=headers)
        r = c.getresponse()
        raw = r.read(1024 * 1024 + 1)
        c.close()
    except (OSError, ssl.SSLError, http.client.HTTPException) as e:
        lines.append(type(e).__name__)
        return emit(2, t['down'])
    if r.status in (401, 403):
        return emit(3, t['auth'] + ' (' + str(r.status) + ')')
    if r.status != 200:
        return emit(2, t['http'] + ' ' + str(r.status))
    try:
        if len(raw) > 1024 * 1024:
            raise ValueError()
        d = json.loads(raw)
        checks = d['checks']
        if not isinstance(checks, list) or not all(isinstance(x, dict) and x.get('status') in STATE for x in checks):
            raise ValueError()
        mx = d.get('metrics') or {}
    except (ValueError, KeyError, TypeError):
        return emit(3, t['invalid'])
    ignore = {x.strip() for x in a.ignore.split(',') if x.strip()}
    counted = [x for x in checks if x.get('name') not in ignore]
    code = max((STATE[x['status']] for x in counted), default=0)
    bad = [x for x in counted if x['status'] != 'ok']
    bad.sort(key=lambda x: -STATE[x['status']])
    coll = next((x for x in checks if x.get('name') == 'collector'), {})
    perf.update(problems=len(bad), events1h=mx.get('events_1h'), blocked1h=mx.get('blocked_1h'),
                blocked24h=mx.get('blocked_24h'), lasteventagesec=mx.get('last_event_age_seconds'),
                collectorlagsec=coll.get('lag_seconds'), ipblocks=mx.get('ip_blocks_active'),
                openalerts=mx.get('open_alerts'), pendingchanges=mx.get('pending_changes'))
    ver = str(d.get('version') or '?')[:20]
    if bad:
        summary = ' · '.join(t.get(x.get('name'), str(x.get('name'))) + colon + msg(str(x.get('message') or x['status']))
                             for x in bad[:3])
    else:
        summary = t['ok'] + ' · jt-waf-mgr ' + ver
    lines.append('')
    for x in checks:
        mark = {'ok': 'OK', 'warning': 'WARN', 'critical': 'CRIT'}[x['status']]
        lines.append('[' + mark + '] ' + t.get(x.get('name'), str(x.get('name'))) + colon + msg(str(x.get('message') or ''))
                     + (' ' + t['ignored'] if x.get('name') in ignore else ''))

    def fmt(v):
        return '%d' % v if number(v) else t['none']
    lines.extend(['', t['events1h'] + colon + fmt(mx.get('events_1h')) + ' · ' + t['blocked1h'] + colon + fmt(mx.get('blocked_1h'))
                  + ' · ' + t['blocked24h'] + colon + fmt(mx.get('blocked_24h')),
                  t['lastevent'] + colon + (fmt(mx.get('last_event_age_seconds')) + ' ' + t['ago']
                                           if number(mx.get('last_event_age_seconds')) else t['none']),
                  t['ipblocks'] + colon + fmt(mx.get('ip_blocks_active')) + ' · ' + t['alerts'] + colon + fmt(mx.get('open_alerts'))
                  + ' · ' + t['pending'] + colon + fmt(mx.get('pending_changes')),
                  '', 'jt-waf-mgr ' + ver + ' · ' + str(d.get('node_id') or '?')[:40]])
    return emit(code, summary)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as e:   # noqa: BLE001
        print('JT-WAF-MGR UNKNOWN - ' + type(e).__name__)
        sys.exit(3)
