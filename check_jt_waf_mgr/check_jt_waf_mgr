"""LibreNMS/Nagios check of jt-waf-mgr (nginx + ModSecurity WAF manager). -l zh-tw|en; default zh-tw.
Read-only: GET /api/v1/health with an API token (scope status:read); changes nothing.
The overall state is the worst check jt-waf-mgr reports; --ignore leaves named checks out of it.
Perfdata keys are fixed across language and state.
Version: 1.0
Author: Jason Cheng (Jason Tools) <jason@jason.tools>
https://github.com/jasoncheng7115/jt-lnms-plugins
"""
import argparse
import http.client
import json
import math
import socket
import ssl
import sys
from pathlib import Path

