           'ago': '秒前', 'ipblocks': '封鎖中的 IP', 'alerts': '待處理警示', 'pending': '待核准變更', 'none': '無',
           'nginx': 'nginx', 'modsecurity': 'ModSecurity', 'managed_rules': '受管理規則檔', 'last_apply': '最近一次套用',
           'collector': '事件收集', 'ip_blocks': 'IP 封鎖清單', 'program_integrity': '程式完整性', 'audit_chain': '稽核鏈',
           'config_changes': '設定被外部修改', 'analyst': '事件分析',
           'm.running': '執行中', 'm.not running': '未執行', 'm.blocking': '封鎖模式',
           'm.detection only: nothing is blocked': '只偵測，不會封鎖', 'm.engine off': '引擎已關閉',
           'm.no ModSecurity configuration found': '找不到 ModSecurity 設定', 'm.no CRS rules loaded': '沒有載入 CRS 規則',
